# ==============================================================
# HRGenius Environment Configuration Example
# Copy this file to .env and adjust values for your deployment
# ==============================================================

# Password of the built-in 'admin' account (8+ chars, upper, lower, number, symbol)
ADMIN_PASSWORD=

# Oracle Database Credentials
ORACLE_PASSWORD=hrgenius_pwd
DB_USERNAME=hrgenius
DB_PASSWORD=hrgenius_pwd

# JWT Secret (Must be at least 256 bits / 32 bytes in production)
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# Public URL of the frontend (used in password reset emails)
APP_FRONTEND_URL=http://localhost

# "Sign in with Google": your OAuth client ID (leave empty to use the one built into the project)
GOOGLE_CLIENT_ID=

# Set to true if new sign-ups must wait for an administrator
APP_SIGNUP_REQUIRES_APPROVAL=false

# Only allow sign-ups from these email domains, comma-separated (empty = any domain)
APP_SIGNUP_ALLOWED_DOMAINS=

# SMTP server for password reset emails
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
